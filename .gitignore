# HomeBuild's ignore list: curated for macOS, VS Code, Rider, .NET, Node and the AWS CDK (C8 Lab 0).
# One rule per thing this repository actually produces; add a group with a comment when a new tool needs one.

# macOS
.DS_Store

# Editors: VS Code (no shared settings are committed), JetBrains Rider
.vscode/
.idea/
*.sln.iml
*.DotSettings.user

# .NET build output, test results and binary logs
[Bb]in/
[Oo]bj/
TestResults/
*.binlog

# Build artifacts: migration bundles and scripts from CI and local runs
artifacts/

# Node packages (api-tests/ and infra/) and Bruno's JUnit reports
node_modules/
api-tests/results/

# AWS CDK synth output
infra/cdk.out/
infra/.cdk.staging/

# Downloaded tools (pinned and checksum-checked by their scripts): Tailwind CLI, Stripe CLI
tools/.tailwindcss/
tools/stripe
tools/stripe_*

# Generated by the Tailwind MSBuild target from Styles/app.css
src/HomeBuild.Web/wwwroot/app.css

# Local-only files: secrets, overrides and logs
*.local
.env
*.log

# C11 Lab 2: the Lambda Runtime Interface Emulator (downloaded binary, for local test invocations)
tools/aws-lambda-rie-arm64

# C11 Lab 5: the Aspire AppHost synthesizes the CDK stacks into its own cdk.out (contains the account ID; never commit)
cdk.out/
