    <ProjectReference Include="..\HomeBuild.Domain\HomeBuild.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Internals are visible to the module's own test project and nothing else. -->
    <InternalsVisibleTo Include="HomeBuild.Payments.Tests" />
  </ItemGroup>

</Project>
