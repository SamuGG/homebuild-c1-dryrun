<Project Sdk="Microsoft.NET.Sdk">

  <!-- Payments' core (C6 Lab 4): rules and contracts only. It references HomeBuild.Domain and the base library,
       never an adapter: adapters (Stripe, EF Core) live in HomeBuild.Payments.Infrastructure, which references this. -->
