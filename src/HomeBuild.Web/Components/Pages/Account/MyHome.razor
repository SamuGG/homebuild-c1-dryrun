@page "/my-home"
@attribute [Authorize]
@inject HomeApiClient Api
@inject NavigationManager Navigation

@* Static SSR behind sign-in: no circuit. The buyer DTO (GET /v2/me/progress) has only the buyer's own homes and a
   simplified progress; staff-only fields never reach this server, let alone the browser. *@
<PageTitle>My home · HomeBuild</PageTitle>

<h1 class="mb-6 text-3xl font-bold">My home</h1>

@if (me is not null)
{
    <p class="mb-6">Signed in as <strong>@user?.Identity?.Name</strong> · @string.Join(", ", me.Roles)</p>
}

@* C8 Lab 1: Stripe sends the buyer back here. The query string says only where they came from: it proves nothing
   about payment (anyone can open these URLs), so nothing is marked paid here. Lab 2's signed webhook does that. *@
@if (DepositReturn == "paid")
{
    <p class="mb-6" role="status" data-testid="deposit-returned">Thank you. We will confirm your reservation as soon as Stripe confirms the payment.</p>
}
else if (DepositReturn == "cancelled")
{
    <p class="mb-6" role="status" data-testid="deposit-cancelled">Payment cancelled. Nothing was charged, and your reservation is still held.</p>
}

@* C10 Lab 2: back from Stripe after paying for extras: the query string proves nothing; the basket says "confirming" until the webhook. *@
@if (ExtrasReturn == "paid")
{
    <p class="mb-6" role="status" data-testid="extras-returned">Thank you. Your extras show as confirming until Stripe confirms the payment.</p>
}

@if (payProblem is not null)
{
    <p class="mb-6 text-danger-600" role="alert" data-testid="pay-problem">@payProblem</p>
}

@if (progress is not null)
{
    <h2 class="mb-3 text-xl font-semibold">Your homes</h2>
    @if (progress.Homes.Count == 0)
    {
        <p data-testid="no-homes">You have no reservations yet. <a class="@Styles.Link" href="developments">Browse the developments</a>.</p>
    }
    else
    {
        <ul class="grid gap-4" data-testid="homes">
            @foreach (var home in progress.Homes)
            {
                <li>
                    <Card Title="@($"Plot {home.PlotNumber}, {home.DevelopmentName}")">
                        <p><Badge Text="@home.ReservationState" Variant="BadgeVariant.Success" /></p>
                        <p class="mt-3">
                            <label for="progress-@home.ReservationId" class="font-semibold">Build progress: @home.Progress.Stage</label>
                            <progress id="progress-@home.ReservationId" class="block w-full max-w-md" value="@home.Progress.StepsDone" max="@home.Progress.StepsTotal">
                                @home.Progress.StepsDone of @home.Progress.StepsTotal steps
                            </progress>
                            <span class="text-sm">@home.Progress.StepsDone of @home.Progress.StepsTotal steps done@(home.Progress.NextStep is { } next ? $"; next: {next}" : "")</span>
                        </p>
                        <p class="mt-3"><a class="@Styles.Link" href="my-home/reservations/@home.ReservationId">Reservation details</a></p>
                        @* C10 Lab 1: extras open now, from Extras' copy of this home's progress (it can lag the board by a message). *@
                        @{ var basket = baskets.FirstOrDefault(b => b.UnitId == home.UnitId && b.Status != "paid"); }
                        @if (extras.FirstOrDefault(x => x.UnitId == home.UnitId) is { OpenExtras.Count: > 0 } open)
                        {
                            <div class="mt-3" data-testid="extras-@home.UnitId">
                                <h3 class="font-semibold">Extras you can choose now</h3>
                                <ul class="list-disc pl-6">
                                    @foreach (var extra in open.OpenExtras)
                                    {
                                        <li>
                                            @extra.Name, @extra.Price.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-GB")) <span class="text-sm">(until @extra.ClosesAt completes)</span>
                                            @if (basket is null or { Status: "open" })
                                            {
                                                @* C10 Lab 2: a plain form post per extra (static SSR). *@
                                                <form method="post" @formname="@($"add-extra-{home.UnitId}-{extra.Id}")" @onsubmit="() => AddExtraAsync(home.UnitId, extra.Id)" class="inline" data-testid="add-extra-@extra.Id">
                                                    <AntiforgeryToken />
                                                    <Button Type="submit">Add</Button>
                                                </form>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        @* C10 Lab 2: the basket, then each order. "Confirming" until the payment webhook is processed: never "Paid" before. *@
                        @foreach (var b in baskets.Where(b => b.UnitId == home.UnitId))
                        {
                            <div class="mt-3" data-testid="basket-@b.Id">
                                <h3 class="font-semibold">@(b.Status switch { "open" => "Your basket", "confirming" => "Extras: payment received, confirming…", _ => "Extras: paid" })</h3>
                                <ul class="list-disc pl-6">
                                    @foreach (var line in b.Lines)
                                    {
                                        @* C10 Lab 3: each line's state, as far as the system has got: never ahead of it. *@
                                        <li data-testid="line-@line.Id">@line.Name × @line.Quantity, @((line.UnitPrice * line.Quantity).ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-GB"))) · <span data-testid="state">@line.State</span>@(line.Status is "refunded" or "refund-pending" ? $" (refunded: {line.Reason})" : "")</li>
                                    }
                                </ul>
                                <p>Total @b.Total.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-GB"))</p>
                                @if (b.Status == "open")
                                {
                                    <form method="post" @formname="@($"pay-extras-{b.Id}")" @onsubmit="() => PayExtrasAsync(home.UnitId)" class="mt-2" data-testid="pay-extras-@b.Id">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="idempotency-key" value="@Guid.NewGuid()" />
                                        <Button Type="submit">Pay for extras</Button>
                                    </form>
                                }
                            </div>
                        }
                        @foreach (var refund in deposits.Where(d => d.ReservationId == home.ReservationId && d.Status != "paid"))
                        {
                            @* C8 Lab 5: a late payment that could not be kept, and why. *@
                            <p class="mt-3" role="status" data-testid="refund-@home.ReservationId">
                                @(refund.Status == "refunded" ? "Deposit refunded" : "Refund in progress"):
                                @refund.Amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-GB")). @refund.Reason
                            </p>
                        }
                        @if (home.ReservationState == "Held")
                        {
                            @* A plain form post (not enhanced): the answer is a redirect to Stripe's hosted page. *@
                            <form method="post" @formname="@($"pay-deposit-{home.ReservationId}")" @onsubmit="() => PayDepositAsync(home.ReservationId)" class="mt-3" data-testid="pay-deposit-@home.ReservationId">
                                <AntiforgeryToken />
                                <input type="hidden" name="idempotency-key" value="@Guid.NewGuid()" />
                                <Button Type="submit">Pay deposit</Button>
                                <span class="ml-2 text-sm">Held until @home.ReservationExpiresAt.ToString("d MMM yyyy, HH:mm", System.Globalization.CultureInfo.GetCultureInfo("en-GB")) UTC</span>
                            </form>
                        }
                    </Card>
                </li>
            }
        </ul>
    }

    <h2 class="mb-3 mt-8 text-xl font-semibold">Documents</h2>
    <p data-testid="documents">Your contract, warranty and floor plans will appear here.</p>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private System.Security.Claims.ClaimsPrincipal? user;
    private CurrentUser? me;
    private MyProgress? progress;
    private string? payProblem;
    private IReadOnlyList<MyDeposit> deposits = [];
    private IReadOnlyList<MyExtras> extras = [];
    private IReadOnlyList<Basket> baskets = [];

    [SupplyParameterFromForm(Name = "idempotency-key")]
    private Guid? PayKey { get; set; } // C8 Lab 3: from the form that was rendered, so a double click sends one key

    [SupplyParameterFromQuery(Name = "deposit")]
    private string? DepositReturn { get; set; }

    [SupplyParameterFromQuery(Name = "extras")]
    private string? ExtrasReturn { get; set; }

    protected override async Task OnInitializedAsync()
    {
        user = AuthenticationState is null ? null : (await AuthenticationState).User;
        me = await Api.GetMeAsync();
        progress = user!.IsInRole("buyer") ? await Api.GetMyProgressAsync() : new MyProgress([]);
        deposits = user.IsInRole("buyer") ? await Api.GetMyDepositsAsync() : [];
        extras = user.IsInRole("buyer") ? await Api.GetMyExtrasAsync() : [];
        baskets = user.IsInRole("buyer") ? await Api.GetMyBasketsAsync() : [];
    }

    private async Task AddExtraAsync(Guid unitId, Guid extraId)
    {
        var added = await Api.AddExtraAsync(unitId, extraId);
        if (added.Succeeded)
        {
            Navigation.NavigateTo("my-home"); // post/redirect/get: the page reloads with the basket
            return;
        }

        payProblem = added.Problem!.Detail ?? added.Problem.Title;
    }

    private async Task PayExtrasAsync(Guid unitId)
    {
        var session = await Api.StartBasketCheckoutAsync(unitId, PayKey ?? Guid.NewGuid());
        if (session.Succeeded)
        {
            Navigation.NavigateTo(session.Value!.ToString()); // to Stripe's hosted page
            return;
        }

        payProblem = $"{session.Problem!.Title}: {session.Problem.Detail}";
    }

    private async Task PayDepositAsync(Guid reservationId)
    {
        var session = await Api.StartDepositSessionAsync(reservationId, PayKey ?? Guid.NewGuid());
        if (session.Succeeded)
        {
            Navigation.NavigateTo(session.Value!.ToString()); // static SSR: answered as a 302 to Stripe's hosted page
            return;
        }

        payProblem = session.Problem!.Status == StatusCodes.Status404NotFound
            ? "That reservation was not found."
            : $"{session.Problem.Title}: {session.Problem.Detail}";
    }
}
