@page "/units/{UnitId:guid}"
@inject CatalogueClient Catalogue
@inject NavigationManager Navigation

@if (unit is not null && development is not null)
{
    <PageTitle>Plot @unit.PlotNumber, @development.Name · HomeBuild</PageTitle>

    <p class="mb-2"><a class="@Styles.Link" href="developments/@development.Id">@development.Name</a></p>
    <h1 class="mb-6 text-3xl font-bold">Plot @unit.PlotNumber</h1>
    <UnitFacts Unit="unit" Development="development" />
}

@code {
    [Parameter]
    public Guid UnitId { get; set; }

    private Unit? unit;
    private Development? development;

    protected override async Task OnParametersSetAsync()
    {
        unit = await Catalogue.GetUnitAsync(UnitId);
        development = unit is null ? null : await Catalogue.GetDevelopmentAsync(unit.DevelopmentId);
        if (unit is null || development is null)
        {
            Navigation.NotFound();
        }
    }
}
