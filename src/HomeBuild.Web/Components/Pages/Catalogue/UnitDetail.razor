@page "/units/{UnitId:guid}"
@inject CatalogueClient Catalogue
@inject NavigationManager Navigation

@if (unit is not null && development is not null)
{
    <PageTitle>Plot @unit.PlotNumber, @development.Name · HomeBuild</PageTitle>

    <p class="mb-2"><a class="text-brand-700 hover:underline" href="developments/@development.Id">@development.Name</a></p>
    <h1 class="mb-6 text-3xl font-bold">Plot @unit.PlotNumber</h1>
    <dl data-testid="unit" class="grid max-w-md grid-cols-[auto_1fr] gap-x-6 gap-y-2 rounded-card bg-white p-6 shadow-sm">
        <dt class="font-semibold">Price</dt>
        <dd>@Money.Format(unit.Price.Amount, unit.Price.Currency)</dd>
        <dt class="font-semibold">Status</dt>
        <dd>@unit.Status</dd>
        <dt class="font-semibold">Development</dt>
        <dd>@development.Name, @development.Town</dd>
    </dl>
}

@code {
    [Parameter]
    public Guid UnitId { get; set; }

    private Unit? unit;
    private Development? development;

    protected override async Task OnParametersSetAsync()
    {
        unit = await Catalogue.GetUnitAsync(UnitId);
        development = unit is null ? null : await Catalogue.GetDevelopmentAsync(unit.DevelopmentId);
        if (unit is null || development is null)
        {
            Navigation.NotFound();
        }
    }
}
