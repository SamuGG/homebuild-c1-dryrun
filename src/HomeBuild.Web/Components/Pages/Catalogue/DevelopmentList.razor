@page "/"
@page "/developments"
@attribute [StreamRendering]
@inject CatalogueClient Catalogue

<PageTitle>Developments · HomeBuild</PageTitle>

<h1 class="mb-6 text-3xl font-bold">Developments</h1>

@if (developments is null)
{
    <p role="status" data-testid="loading" class="text-brand-700">Loading developments…</p>
}
else if (developments.Count == 0)
{
    <p>No developments yet.</p>
}
else
{
    <ul data-testid="developments" class="grid gap-4 sm:grid-cols-2">
        @foreach (var (development, units) in developments)
        {
            <li class="rounded-card bg-white p-6 shadow-sm">
                <h2 class="text-xl font-semibold"><a class="text-brand-700 hover:underline" href="developments/@development.Id">@development.Name</a></h2>
                <p class="mt-2">@development.Town · @units.Count(u => u.Status == "Available") of @units.Count homes available</p>
            </li>
        }
    </ul>
}

@code {
    private List<(DevelopmentSummary Development, IReadOnlyList<UnitSummary> Units)>? developments;

    // Streaming rendering: the shell above (heading and "Loading") is flushed first; this runs while the
    // response stays open, and the list is streamed into the same response when the API calls finish.
    protected override async Task OnInitializedAsync()
    {
        var page = await Catalogue.ListDevelopmentsAsync();
        var units = await Task.WhenAll(page.Items.Select(d => Catalogue.ListUnitsAsync(d.Id)));
        developments = [.. page.Items.Zip(units, (d, u) => (d, u?.Items ?? []))];
    }
}
