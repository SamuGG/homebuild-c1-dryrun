@page "/developments/{DevelopmentId:guid}"
@inject CatalogueClient Catalogue
@inject NavigationManager Navigation

@if (development is not null)
{
    <PageTitle>@development.Name · HomeBuild</PageTitle>

    <h1 class="text-3xl font-bold">@development.Name</h1>
    <p class="mb-6 text-brand-700">@development.Town</p>
    <AuthorizeView Roles="site-manager,admin">
        <p class="mb-6"><a class="@Styles.Link" href="staff/developments/@development.Id/board">Build board</a></p>
    </AuthorizeView>

    <h2 class="mb-3 text-xl font-semibold">Homes</h2>
    <DataTable Items="units.Items" Caption="@($"Homes at {development.Name}, by price")" data-testid="units">
        <HeaderContent>
            <th scope="col" class="p-3">Plot</th>
            <th scope="col" class="p-3">Price</th>
            <th scope="col" class="p-3">Status</th>
        </HeaderContent>
        <RowTemplate Context="unit">
            <td class="p-3"><a class="@Styles.Link" href="units/@unit.Id">Plot @unit.PlotNumber</a></td>
            <td class="p-3"><PriceTag Amount="unit.Price" Currency="@unit.Currency" /></td>
            <td class="p-3"><Badge Text="@unit.Status" Variant="Badge.ForUnitStatus(unit.Status)" /></td>
        </RowTemplate>
        <EmptyContent>
            <p>No homes listed yet.</p>
        </EmptyContent>
    </DataTable>
    <Pager Next="@units.Next" IsFirstPage="After is null" Label="Homes pages" />
}

@code {
    public const int PageSize = 20;

    [Parameter]
    public Guid DevelopmentId { get; set; }

    [SupplyParameterFromQuery]
    public string? After { get; set; }

    private Development? development;
    private UnitPage units = new([], null);

    // Parameter-dependent data loads in OnParametersSetAsync, so a new ID or page never shows the previous one.
    protected override async Task OnParametersSetAsync()
    {
        development = await Catalogue.GetDevelopmentAsync(DevelopmentId);
        if (development is null)
        {
            Navigation.NotFound();
            return;
        }

        units = await Catalogue.ListUnitsAsync(DevelopmentId, After, PageSize) ?? new([], null);
    }
}
