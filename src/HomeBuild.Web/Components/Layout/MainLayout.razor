@inherits LayoutComponentBase

<a href="#main" class="sr-only rounded-card bg-white p-3 text-brand-900 focus:not-sr-only focus:absolute focus:left-4 focus:top-4 @Styles.FocusRing">Skip to main content</a>

<div class="min-h-screen bg-brand-50 font-sans text-brand-900">
    <header class="bg-brand-700 text-white">
        <nav class="mx-auto flex max-w-5xl items-center gap-6 px-4 py-3" aria-label="Main">
            <a href="" class="text-lg font-semibold hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">HomeBuild</a>
            <a href="developments" class="hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Developments</a>
        </nav>
    </header>

    <main id="main" tabindex="-1" class="mx-auto max-w-5xl px-4 py-8 outline-none">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
