@inject HomeApiClient Api

@* The page's only interactive island (InteractiveServer, set where the page uses it): filtering is live, so it needs a
   circuit. Board data and the filter inputs are [PersistentState]: the board loads once across prerender and the
   circuit start, and if the circuit is lost and resumed the inputs come back. While the connection is down the
   template's ReconnectModal shows "Rejoining the server…". *@
@if (Data is null)
{
    <p role="status">Loading the board…</p>
}
else
{
    <div class="mb-4 flex flex-wrap items-end gap-4">
        <div>
            <label for="stage" class="block font-semibold">Stage</label>
            <select id="stage" @bind="Stage" class="mt-1 rounded-card border border-brand-700 bg-white p-2 @Styles.FocusRing">
                <option value="">All stages</option>
                @foreach (var milestone in Data.Milestones)
                {
                    <option value="@milestone">@milestone</option>
                }
                <option value="@Finished">@Finished</option>
            </select>
        </div>
        <div>
            <label for="plot-search" class="block font-semibold">Plot</label>
            <input id="plot-search" @bind="PlotSearch" @bind:event="oninput" placeholder="e.g. P2"
                   class="mt-1 rounded-card border border-brand-700 bg-white p-2 @Styles.FocusRing" />
        </div>
        <p role="status" aria-live="polite" class="text-brand-700" data-testid="row-count">@Rows.Count of @Data.Rows.Count plots</p>
    </div>

    <div class="overflow-x-auto">
        <DataTable Items="Rows" Caption="@($"Build milestones at {Data.DevelopmentName}")" CaptionVisible="true" data-testid="board">
            <HeaderContent>
                <th scope="col" class="p-3">Plot</th>
                @foreach (var milestone in Data.Milestones)
                {
                    <th scope="col" class="p-3">@milestone</th>
                }
            </HeaderContent>
            <RowTemplate Context="row">
                <th scope="row" class="p-3">@row.PlotNumber</th>
                @foreach (var cell in row.Cells)
                {
                    <td class="p-3 align-top">
                        <Badge Text="@Label(cell.Status)" Variant="@Variant(cell.Status)" />
                        @if (cell.CompletedOn is { } on)
                        {
                            <div class="text-sm">@on.ToString("d MMM", System.Globalization.CultureInfo.GetCultureInfo("en-GB"))</div>
                        }
                        @if (cell.OpenDefects > 0)
                        {
                            <div class="text-sm text-danger-600">@cell.OpenDefects open defects</div>
                        }
                        @if (cell.SiteNotes.Length > 0)
                        {
                            <div class="text-sm">@cell.SiteNotes</div>
                        }
                        <div class="text-sm text-brand-700">@cell.Subcontractor</div>
                    </td>
                }
            </RowTemplate>
            <EmptyContent>
                <p>No plots match.</p>
            </EmptyContent>
        </DataTable>
    </div>
}

@code {
    private const string Finished = "Finished";

    [Parameter, EditorRequired]
    public Guid DevelopmentId { get; set; }

    [PersistentState]
    public Board? Data { get; set; }

    [PersistentState(AllowUpdates = true)]
    public string? Stage { get; set; }

    [PersistentState(AllowUpdates = true)]
    public string? PlotSearch { get; set; }

    private IReadOnlyList<BoardRow> Rows => [.. Data!.Rows
        .Where(r => string.IsNullOrEmpty(Stage) || (r.CurrentStage ?? Finished) == Stage)
        .Where(r => r.PlotNumber.Contains((PlotSearch ?? "").Trim(), StringComparison.OrdinalIgnoreCase))];

    // Parameter-dependent: loads in OnParametersSetAsync; skipped when the prerendered state was restored.
    protected override async Task OnParametersSetAsync()
    {
        if (Data?.DevelopmentId != DevelopmentId)
        {
            Data = await Api.GetBoardAsync(DevelopmentId);
        }
    }

    private static string Label(string status) => status switch
    {
        "InProgress" => "In progress",
        "NotStarted" => "Not started",
        _ => status,
    };

    private static BadgeVariant Variant(string status) => status switch
    {
        "Done" => BadgeVariant.Success,
        "InProgress" => BadgeVariant.Warning,
        _ => BadgeVariant.Neutral,
    };
}
