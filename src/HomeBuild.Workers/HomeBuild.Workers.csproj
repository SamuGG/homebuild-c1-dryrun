<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- C9 Lab 3: the worker host. One BackgroundService per queue it consumes; the first is the contract worker.
       It shares the API's user-secrets (same UserSecretsId) for the local connection string and AWS settings. -->
  <PropertyGroup>
    <UserSecretsId>027b04ea-0e16-497b-a8a8-7da1ad7477ff</UserSecretsId>
      <ContainerRepository>homebuild-workers</ContainerRepository> <!-- C11 Lab 1 -->
    <!-- C11 Lab 3: one multi-platform image (an image index) for arm64 (Mac, CI, Graviton) and amd64. Restore needs
         both runtimes, so they are in the lock file too. -->
    <RuntimeIdentifiers>linux-arm64;linux-x64</RuntimeIdentifiers>
    <ContainerRuntimeIdentifiers>linux-arm64;linux-x64</ContainerRuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- C11 Lab 1: Kestrel for /alive, so the image can be health-checked like the API and the web app. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomeBuild.Domain\HomeBuild.Domain.csproj" />
    <ProjectReference Include="..\HomeBuild.Messaging\HomeBuild.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HomeBuild.Workers.Tests" />
    <InternalsVisibleTo Include="HomeBuild.Architecture.Tests" />
  </ItemGroup>

</Project>
