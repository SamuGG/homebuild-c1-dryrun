<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\HomeBuild.Domain\HomeBuild.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!-- Build-time OpenAPI document, committed as a snapshot reviewers can diff. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
    <!-- Asp.Versioning 10.2 analyzers ask for Asp.Versioning.OpenApi (AddApiVersioning().AddOpenApi(),
         MapOpenApi().WithDocumentPerVersion()). That package needs Microsoft.OpenApi < 3.0 and cannot restore
         next to Microsoft.AspNetCore.OpenApi 11 (NU1107), so versioned documents come from
         Asp.Versioning.Mvc.ApiExplorer group names instead. NoWarn, not .editorconfig, because AV0029 also fires
         in the OpenAPI source generator's output. Remove when a compatible release ships. -->
    <NoWarn>$(NoWarn);AV0029;AV0030</NoWarn>
  </PropertyGroup>

</Project>
