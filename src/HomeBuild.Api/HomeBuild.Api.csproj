<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\HomeBuild.Domain\HomeBuild.Domain.csproj" />
    <!-- C7 Lab 5: the host wires Payments' core (use cases and ports) to adapters it owns. Never the infrastructure project's internals. -->
    <ProjectReference Include="..\HomeBuild.Payments.Core\HomeBuild.Payments.Core.csproj" />
    <!-- C9 Lab 3: the outbox, relay and SNS publisher, shared with the worker host. -->
    <ProjectReference Include="..\HomeBuild.Messaging\HomeBuild.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Extensions.Configuration.SystemsManager" />
    <PackageReference Include="AWSSDK.Extensions.CloudFront.Signers" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="AWSSDK.Scheduler" />
    <PackageReference Include="AWSSDK.SecurityToken" />
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- C8 Lab 1: the Stripe adapter for Payments' IPaymentGateway. Only the host references it; the core never does. -->
    <PackageReference Include="Stripe.net" />
  </ItemGroup>

  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!-- Build-time OpenAPI document, committed as a snapshot reviewers can diff. -->
    <!-- The API contract, committed and diffed in CI (C6 Lab 2): any change is a reviewed diff in the PR. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../contracts</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
    <!-- Asp.Versioning 10.2 analyzers ask for Asp.Versioning.OpenApi (AddApiVersioning().AddOpenApi(),
         MapOpenApi().WithDocumentPerVersion()). That package needs Microsoft.OpenApi < 3.0 and cannot restore
         next to Microsoft.AspNetCore.OpenApi 11 (NU1107), so versioned documents come from
         Asp.Versioning.Mvc.ApiExplorer group names instead. NoWarn, not .editorconfig, because AV0029 also fires
         in the OpenAPI source generator's output. Remove when a compatible release ships. -->
    <NoWarn>$(NoWarn);AV0029;AV0030</NoWarn>
    <UserSecretsId>027b04ea-0e16-497b-a8a8-7da1ad7477ff</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mapping tests use the module DbContexts directly; they stay internal to the API otherwise. -->
    <InternalsVisibleTo Include="HomeBuild.Api.Tests" />
  </ItemGroup>

</Project>
