meta {
  name: 03 Unit detail
  type: http
  seq: 3
}

get {
  url: {{webUrl}}/units/{{riversidePlot3}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: contains text/html
}

tests {
  test("renders >Plot P3</h1>", function () {
    expect(res.body).to.contain(">Plot P3</h1>");
  });

  test("is static SSR: no interactive component markers", function () {
    expect(res.body).not.to.contain("<!--Blazor:{");
  });
}
