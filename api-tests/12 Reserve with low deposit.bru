meta {
  name: Reserve with low deposit
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/units/{{riversidePlot3}}/reservations
  body: json
  auth: none
}

body:json {
  {
    "buyerId": "11111111-1111-1111-1111-111111111111",
    "deposit": 1,
    "currency": "GBP"
  }
}

assert {
  res.status: eq 422
  res.body.type: eq https://homebuild.dev/problems/deposit-rejected
}
