meta {
  name: Site manager of another development writes the diary
  type: http
  seq: 18
}

post {
  url: {{baseUrlV2}}/units/{{riversidePlot1}}/diary
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{hillcrestSiteManagerToken}}
}

body:json {
  {
    "writtenOn": "2026-11-17",
    "text": "Written by a site manager from another development.",
    "weather": "Dry"
  }
}

assert {
  res.status: eq 403
}
